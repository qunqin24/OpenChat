# Copy to deploy/.env and fill in. Never commit the copy.

# The domain the site is served on. Its DNS A/AAAA record must point at this
# server before the first start, so Caddy can obtain the certificate.
DOMAIN=chat.example.com

# Database password: anything long and random, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# The time zone of "a day" and "a month" for the daily and monthly spending
# caps on models (后台 → 模型): they start over at this zone's midnight. An IANA
# name such as Asia/Shanghai (the default) or America/New_York.
TZ=Asia/Shanghai

# production (default) requires HTTPS for sign-in cookies.
APP_ENV=production

# The app image. Pin a version to choose when to upgrade:
# OPENCHAT_IMAGE=ghcr.io/qunqin24/openchat:1.0.0
