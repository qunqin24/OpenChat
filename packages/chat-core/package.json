    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@openchat/api-client": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/query-core": "^5.102.8",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "i18next": "^26.4.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
