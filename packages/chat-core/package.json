{
  "name": "@openchat/chat-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The chat client's logic, shared by the web app and the mobile app: pure functions, types and store creators, no React, no DOM.",
  "exports": {
    "./*": "./src/*.ts",
    "./genui/*": "./src/genui/*.ts",
    "./locales/*": "./locales/*"
