# Copy to .env and adjust. Loaded by the Go server and docker compose.

APP_ENV=development
APP_VERSION=dev

HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT=15s

DATABASE_URL=postgres://openchat:openchat@localhost:5432/openchat?sslmode=disable

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=openchat
S3_ACCESS_KEY_ID=openchat
S3_SECRET_ACCESS_KEY=openchat-secret
S3_USE_PATH_STYLE=true
