# Copy to .env and adjust. Loaded by the Go server and docker compose.

APP_ENV=development

HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT=15s

DATABASE_URL=postgres://openchat:openchat@localhost:5432/openchat?sslmode=disable

# The key that seals plugin credentials (request headers, people's account
# tokens) is made on the first start in data/secret.key. Set this only to
# supply your own instead (32 bytes, base64: openssl rand -base64 32).
# OPENCHAT_SECRET_KEY=
