{
  "name": "openchat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @openchat/web dev",
    "build": "pnpm --filter @openchat/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "gen:api": "pnpm --filter @openchat/api-client generate",
    "sync:model-icons": "node scripts/sync-model-icons.mjs"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3"
    }
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "^1.95.0"
  }
}
