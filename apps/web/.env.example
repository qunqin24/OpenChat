# Base URL the browser uses for API calls. Leave as-is to go through the Vite proxy.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev proxy forwards /api requests.
VITE_PROXY_TARGET=http://localhost:8080

# Set to true to show the TanStack Router/Query devtools buttons (dev only).
VITE_DEVTOOLS=false
